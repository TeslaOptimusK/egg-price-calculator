<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EggPriceCalc" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent_press</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/separator</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Egg.Segment</item>
        <item name="chipStyle">@style/Widget.Egg.Chip</item>
    </style>

    <style name="Widget.Egg.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/separator</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Widget.Egg.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/bg</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <style name="Text.Egg.GroupTitle" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Text.Egg.Hero" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>
</resources>
